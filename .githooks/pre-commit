#!/usr/bin/env bash
# Refuses commits on `main`. Work reaches the trunk by pull request from a
# short-lived branch — see CHECKPOINTS.md.
#
# Installed by: git config core.hooksPath .githooks

branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  echo "refused: no direct commits on main." >&2
  echo "  work reaches the trunk by pull request from a short-lived branch." >&2
  echo "  create one:  git checkout -b feat/<name>" >&2
  exit 1
fi
exit 0
